{
  "name": "proshop-qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aseguramiento de calidad sobre ProShop v2 (MERN) - Caso práctico final",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "app:install": "npm install --prefix app && npm install --prefix app/frontend",
    "app:seed": "npm run data:import --prefix app",
    "app:dev": "npm run dev --prefix app"
  },
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
